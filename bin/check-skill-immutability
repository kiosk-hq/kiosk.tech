     "skills.md", "| `skill-v0.4.3.md` | **0.4** | the \"same wire\" chain below runs 0.4.3 → 0.4.10 only. |\n", :green],
    ["R10 those same stale span bytes in specification.html still fail",
     "specification.html", "the \"same wire\" chain below runs 0.4.3 → 0.4.9 only.", :red],
    ["R10 a CHANGELOG record of a past span is history (K-1229)",
     "CHANGELOG.md", "- 2026-08-27: the chain then ran 0.4.3 → 0.4.9 only.\n", :green],
    ["R10 an ordinary two-component arrow is not a span",
     "specification.html", "A new MINOR (0.3 → 0.4) is a feature milestone.", :green]
  ].freeze
end

def self_test_table_cases(descending)
  [
    ["R6 table carries every cut on the newest series", fixture_table(descending), :green],
    ["R6 table missing the newest cut's row", fixture_table(descending.drop(1)), :red],
    ["R6 table written oldest-first", fixture_table(descending.reverse), :red],
    # K-1232's row-body arm. One row differs from the green table above, so what
    # is under test is the body and not the table's shape.
    ["R9 a row body naming the wrong predecessor (K-1232)",
     fixture_table(descending, "0.4.10" => ["**0.4**", "The same wire as 0.4.8."]), :red],
    ["R9 a row body naming its predecessor",
     fixture_table(descending, "0.4.10" => ["**0.4**", "The same wire as 0.4.9."]), :green],
    ["R9 a MIDDLE row body naming the wrong predecessor",
     fixture_table(descending, "0.4.5" => ["**0.4**", "The same wire as 0.4.3."]), :red],
    ["R9 a row body naming its predecessor, mid-table",
     fixture_table(descending, "0.4.5" => ["**0.4**", "The same wire as 0.4.4."]), :green],
    ["R9 a row's protocol column naming a series its cut is not on (K-1232)",
     fixture_table(descending, "0.4.10" => ["**0.3**", "some wire"]), :red]
  ].freeze
end

# [label, specification.html body, :red | :green]. R11 asks ONE question — is
# there a list here at all — so its fixtures are a page with one and a page
# without. The third case is the boundary that matters: a list R8 will reject is
# still a list, and R11 must not double-report it.
def self_test_history_page_cases
  [
    ["R11 the normative page with NO per-cut history list at all (K-1236)",
     "<p>Every earlier cut stays published and unedited, because live pins verify its bytes.</p>",
     :red],
    ["R11 the normative page carrying the list",
     "<p>0.4.0–0.4.2 on wires that have since changed, and 0.4.3 on this same wire but A.</p>",
     :green],
    ["R11 a list R8 will reject is still a list — R11 does not double-report it",
     "<p>0.4.3 on this same wire but A.</p>", :green]
  ].freeze
end

# Every rule must find something to say about this repository's own files.
VACUITY_RULES = {
  current_claim: "R1 a sentence naming the current cut",
  serves_claim: "R1 a sentence saying what a cut's operator serves",
  earlier_wires: "R2 the earlier-cuts range on the newest series",
  earlier_protocols: "R3 the earlier-protocols range",
  named_cut: "R5 a cut named in prose",
  pin_url: "R4 an example pin URL",
  same_wire_chain: "R7 the cut table's same-wire chain",
  history_clause: "R8 the per-cut history clause list",
  chain_span: "R10 the same-wire group written as an arrow span",
  row_protocol: "R9 a cut table row's protocol column",
  row_same_wire: "R9 a cut table row body's \"same wire as\" predecessor"
}.freeze

def run_self_test
  ctx        = context_for(FIXTURE_CUTS)
  descending = (0..10).to_a.reverse.map { "0.4.#{_1}" }
  bad        = []

  self_test_prose_cases.each do |label, path, body, want|
    got, = prose_failures(path, body, ctx)
    red  = !got.empty?
    if red == (want == :red)
      puts format("  %-5s %s", want == :red ? "RED" : "GREEN", label)
    else
      bad << "#{label}: expected #{want}, got #{red ? "red" : "green"}#{red ? " (#{got.first})" : ""}"
    end
  end

  self_test_table_cases(descending).each do |label, table, want|
    got, = cut_table_failures(table, ctx)
    red = !got.empty?
    if red == (want == :red)
      puts format("  %-5s %s", want == :red ? "RED" : "GREEN", label)
    else
      bad << "#{label}: expected #{want}, got #{red ? "red" : "green"}"
    end
  end

  self_test_history_page_cases.each do |label, body, want|
    got = history_page_failures(body, ctx)
    red = !got.empty?
    if red == (want == :red)
      puts format("  %-5s %s", want == :red ? "RED" : "GREEN", label)
    else
      bad << "#{label}: expected #{want}, got #{red ? "red" : "green"}"
    end
  end

  # The vacuity arm, over the real tree. `cuts` is re-read rather than taken
  # from the passes above, so this method says the same thing wherever it is
  # called from.
  published = cuts
  if published.any?
    real = context_for(published)
    seen = []
    prose_files.each { |p| seen |= prose_failures(p, File.read(p), real)[2] }
    # R9's subject lives in the cut table, which prose_failures does not read as
    # rows, so the arm has to ask cut_table_failures the same question.
    seen |= cut_table_failures(File.read(CUT_TABLE), real)[1] if File.exist?(CUT_TABLE)
    VACUITY_RULES.each do |rule, description|
      if seen.include?(rule)
        puts format("  %-5s vacuity: %s", "HIT", description)
      else
        bad << "vacuity: #{description} (#{rule}) matches NOTHING in this repository. A pattern " \
               "with no subject is a pattern that has been switched off, and it exits 0 forever " \
               "— which is exactly how K-1227's three holes stayed open."
      end
    end
  else
    bad << "vacuity: no cut exists on disk, so the arm that proves these rules have subjects " \
           "could not run."
  end

  if bad.empty?
    puts "check-skill-immutability --self-test: OK — every rule is red on a faithful stale-relink, " \
         "green on the history it must leave alone, and has a subject in this repository."
    return true
  end

  warn "\ncheck-skill-immutability --self-test FAILED:\n"
  bad.each { warn "  x #{_1}" }
  false
end

# The self-test asks about the RULES, not about this tree, so it reports its own
# verdict and the passes above do not colour it. The workflow runs both, in that
# order, for the reason publication-paths.yml already records: a guard has to
# prove it is red on a plant before a green run over real files means anything.
if self_test
  exit(run_self_test ? 0 : 1)
end

notes.each { puts "  note: #{_1}" }

if failures.empty?
  puts "check-skill-immutability: OK — no published skill-v*.md was modified or removed, " \
       "and #{ALIAS} is byte-identical to #{newest_cut}."
  exit 0
end

warn "\ncheck-skill-immutability FAILED:\n"
failures.each { warn "  x #{_1}" }
warn "\nA published version file is never edited, and the alias never comes to rest diverged " \
     "from the newest cut. Every change ships a NEW skill-vX.Y.Z.md, the demos are re-pinned in " \
     "the same wave, and skill.md is regenerated from it (ADR-0012, K-847). That is what makes " \
     "the spec's \"byte-identical to the newest version file\" true."
exit 1
