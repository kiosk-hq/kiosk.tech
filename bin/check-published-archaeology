# ── the exemptions ───────────────────────────────────────────────────────────
#
# Each is a decision, so each is declared with the reason it was granted. Every
# run reports the number of tracked files it covers and fails on a zero: an
# exemption whose subject has left the repository is not a decision any more.
#
# THE TEST FOR A NEW ONE IS «IS IT SERVED?», NEVER «IS IT TOOLING?» (K-1500).
# X1 and X2 read as kind exemptions and are not: nothing under `bin/` or
# `.github/` ships. `spec/schemas/validate.sh` is the same kind of file and
# ships beside the schemas it proves, so it stays in scope — see the header,
# and the self-test arm that holds `spec/` free of every exemption here.

EXEMPTIONS = [
  {
    id: "X1",
    what: "bin/",
    why: "maintainer tooling. A guard's header is where the reason a rule exists is written " \
         "down, and the reason is frequently the row that bought it",
    match: ->(rel) { rel.start_with?("bin/") },
  },
  {
    id: "X2",
    what: ".github/",
    why: "continuous-integration tooling, the same class as bin/. A workflow is read by a " \
         "maintainer deciding whether a job earns its minutes, and nothing under it is served",
    match: ->(rel) { rel.start_with?(".github/") },
  },
  {
    id: "X3",
    what: "CHANGELOG.md",
    why: "the sanctioned afterlife. A removed endpoint, key or wire element gets one changelog " \
         "line and nothing else; this is that one line's home",
    match: ->(rel) { rel == "CHANGELOG.md" },
  },
  {
    id: "X4",
    what: "CLAUDE.md",
    why: "a maintainer document, addressed to whoever edits this repository next rather than to " \
         "whoever reads it",
    match: ->(rel) { rel == "CLAUDE.md" },
  },
  {
    id: "X5",
    what: "LICENSE",
    why: "verbatim third-party licence text. This repository may not edit a word of it, so a " \
         "rule reaching it could only produce a red tree with no legal move",
    match: ->(rel) { rel == "LICENSE" },
  },
].freeze

def exempt_for(rel) = EXEMPTIONS.find { |x| x[:match].call(rel) }

# ── the published surface classes ────────────────────────────────────────────
#
# A FLOOR, not an inventory. Each is a kind of thing this site serves; the guard
# fails when the scope stops reaching one, because a glob that quietly narrows
# reports the same clean zero an obeyed ban does. It says nothing about how many
# files of each kind there are, so the site may grow without an edit here.

SURFACES = [
  ["a page a browser renders",        ->(r) { r.end_with?(".html") }],
  ["a document a reader reads",       ->(r) { r.end_with?(".md") }],
  ["a formal-specification file",     ->(r) { r.start_with?("spec/") }],
  ["a JSON Schema or example",        ->(r) { r.end_with?(".json") }],
  ["a frozen published skill cut",    ->(r) { r.match?(/\Askill-v\d+\.\d+\.\d+\.md\z/) }],
  ["the working skill alias",         ->(r) { r == "skill.md" }],
].freeze

def frozen_cut?(rel) = rel.match?(/\Askill-v\d+\.\d+\.\d+\.md\z/)

# ── reading the tree ─────────────────────────────────────────────────────────

def tracked_files(root)
  out, err, status = Open3.capture3("git", "-C", root, "ls-files", "-z")
  raise "check-published-archaeology: `git ls-files` failed in #{root}: #{err.strip}" unless status.success?

  out.split("\0").reject(&:empty?).sort
end

# TEXT is decided from the bytes, never from an extension. Returns nil for
# anything this guard must not read as prose. See the header: the three icons
# this site serves each carry a byte run the Cyrillic rule matches.
def readable_text(bytes)
  return nil if bytes.include?("\0".b)

  text = bytes.dup.force_encoding(Encoding::UTF_8)
  text.valid_encoding? ? text : nil
end

def read_text(abs)
  readable_text(File.binread(abs))
rescue SystemCallError
  nil
end

# ── the scan ─────────────────────────────────────────────────────────────────

Hit = Struct.new(:path, :line, :rule, :where, :text)

def violates?(rule, line)
  return false unless line.match?(rule[:re])
  return false if rule[:exempt] && line.match?(rule[:exempt])

  true
end

# WHERE the reader meets it. There is no lexer here and none is needed: this
# repository publishes documents, not a library, so the whole file is the
# artefact. The one distinction worth drawing is inside a SCRIPT, where a
# leading `#` separates a sentence from an argument — the same conservative
# reading the sibling guard gives a shell file.
def where_of(rel, line)
  case File.extname(rel)
  when ".html"        then :page
  when ".md", ".txt"  then :doc
  when ".json"        then :data
  when ".sh", ".py"   then (line.match?(/^\s*#/) ? :comment : :code)
  else :text
  end
end

WHERE = {
  page:    "on a page a browser renders",
  doc:     "in a document a reader reads",
  data:    "in a machine-readable file an implementer parses",
  comment: "in a comment a reader of the script reads",
  code:    "in a line of script that RUNS",
  text:    "in prose a reader reads",
}.freeze

def scan_text(rel, text, rules = RULES)
  hits = []
  text.each_line.with_index(1) do |line, lineno|
    next if line.match?(TODO_RE)

    rules.each do |rule|
      next unless violates?(rule, line)

      hits << Hit.new(rel, lineno, rule, where_of(rel, line), line.strip[0, 120])
    end
  end
  hits
end

# ── the detector arms: every rule re-proves itself, on every run ─────────────

# A rule may declare several probes and several foils, and R5 is why: a single
# sentence against a seven-way alternation proves one branch and reports a clean
# pass for the other six. The counted constructions are held to the same
# standard — a census whose pattern has stopped matching prints the same clean
# zero a drained backlog does.
def rule_detector_faults(set = RULES + COUNTED)
  faults = []
  set.each do |rule|
    Array(rule[:probe]).each do |probe|
      next if violates?(rule, probe)

      faults << "#{rule[:id]}: a PROBE — one spelling of #{rule[:what]}, written out as a " \
                "sentence rather than derived from the pattern — is no longer flagged, so this " \
                "#{rule[:counted] ? 'census' : 'rule'} would pass over every occurrence of that " \
                "shape in the tree and report a clean zero: #{probe}"
    end
    Array(rule[:foil]).each do |foil|
      next unless violates?(rule, foil)

      faults << "#{rule[:id]}: a FOIL — the nearest thing that is NOT #{rule[:what]} — is now " \
                "flagged, so this #{rule[:counted] ? 'census' : 'rule'} reports correct text and " \
                "will be switched off: #{foil}"
    end
  end
  faults
end

# THE NON-TEXT SKIP, proved in both directions on every run. Neither fixture is
# stored: both are built here, in memory, out of bytes this repository does not
# have to contain.
def text_reader_faults
  faults = []

  nul_blob = "\x89PNG\r\n\x1a\n".b + "K-1035".b + "\0".b
  if readable_text(nul_blob)
    faults << "the non-text skip accepts a blob carrying a NUL byte, so a citation-shaped byte " \
              "run inside an icon would be reported as a violation nobody can repair"
  end

  invalid_blob = "\xFF\xFE".b + "K-1035".b + "\xC3".b
  if readable_text(invalid_blob)
    faults << "the non-text skip accepts bytes that are not valid UTF-8, so a byte run inside a " \
              "compressed image would be read as prose"
  end

  # The other direction, and it is the sharper one: a reader that dropped
  # non-ASCII TEXT would switch R3 off entirely while printing a clean zero.
  cyrillic = "The ruling, verbatim: «убери из демок всю археологию».\n"
  got = readable_text(cyrillic.dup.b)
  if got.nil? || got != cyrillic
    faults << "the non-text skip refuses a valid UTF-8 sentence containing Cyrillic, so R3 would " \
              "never see the very thing it bans and would report a clean zero forever"
  end

  faults
end

# ── the frozen cuts as a vacuity corpus, for the censuses only ───────────────
#
# A CENSUS CANNOT BE PROVED BY ITS OWN COUNT. Zero prints the same whether the
# backlog drained or the pattern stopped matching, and unlike a ban there is no
# exit code to notice. The probes above catch a pattern that no longer matches
# the sentence written beside it; they cannot catch one narrowed until it still
# matches that sentence and nothing anybody actually writes.
#
# THE FROZEN CUTS ARE THE ONE CORPUS THAT ANSWERS THAT HERE. They are IN scope,
# they are real published prose nobody wrote for this purpose, and — this is the
# whole of it — THEY CANNOT BE EDITED. Cut immutability means a count over them
# never falls because somebody repaired something. So a construction MEASURED to
# occur in them can only stop occurring if its pattern broke, and one measured
# ABSENT from them can only start occurring if its pattern widened. That is not
# a hand-kept list; it is a property of a corpus another rule has frozen.
#
# This is why the arm is on the CENSUSES and not on the rules. A corpus arm over
# the EXEMPT files is circular for R3 — its only Cyrillic is this file's own
# fixtures, see the header — and a ban's count over the cuts is already asserted
# to be zero. The cuts are neither exempt nor drainable, so every counted
# construction states which side of them it is on and the run re-measures BOTH
# directions: a `:none` that starts matching a cut is as much a report as a
# `:some` that stops.

def counted_cut_faults(scope, set = COUNTED)
  cuts = scope.files.select { |rel, _| frozen_cut?(rel) }
  set.filter_map do |c|
    n = cuts.sum { |rel, text| scan_text(rel, text, [c]).size }
    case c[:in_cuts]
    when :none
      next if n.zero?

      "#{c[:id]} (#{c[:what]}) is declared ABSENT from the frozen cuts and now matches " \
        "#{n} line(s) in one. A cut describes a wire in the present tense of its own day, so " \
        "either this pattern has widened into something it should not reach, or the " \
        "measurement the declaration rests on was wrong"
    when :some
      next unless n.zero?

      "#{c[:id]} (#{c[:what]}) matches NOTHING in the frozen published cuts, and it was " \
        "measured there when it was written. Those bytes cannot be edited, so nothing can " \
        "have drained them: this census's pattern has stopped matching real prose, and its " \
        "count over the live pages is a clean zero that means nothing"
    else
      "#{c[:id]} declares no `in_cuts:` expectation, so its pattern is held by its own probes " \
        "alone and a narrowing that still matched them would be invisible"
    end
  end
end

# ── the scope arms ───────────────────────────────────────────────────────────

Scope = Struct.new(:files, :skipped, :exempted, :faults)

def build_scope
  faults    = []
  files     = {}
  skipped   = []
  exempted  = Hash.new { |h, k| h[k] = [] }

  tracked = tracked_files(REPO)
  faults << "`git ls-files` names no file — this guard is not looking at a repository" if tracked.empty?

  tracked.each do |rel|
    abs = File.join(REPO, rel)
    next unless File.file?(abs)

    if (x = exempt_for(rel))
      exempted[x[:id]] << rel
      next
    end

    text = read_text(abs)
    if text.nil?
      skipped << rel
      next
    end

    files[rel] = text
  end

  faults << "every tracked file is exempt or non-text — the ban covers nothing" if files.empty?

  EXEMPTIONS.each do |x|
    next unless exempted[x[:id]].empty?

    faults << "#{x[:id]} (#{x[:what]}) covers no tracked file. An exemption whose subject has " \
              "left the repository has stopped being a decision: delete it, or re-point it at " \
              "wherever that content went"
  end

  SURFACES.each do |label, pred|
    next if files.keys.any? { |r| pred.call(r) }

    faults << "the scope reaches no #{label} — a file set that has quietly narrowed reports the " \
              "same clean zero an obeyed ban does"
  end

  cuts = files.keys.count { |r| frozen_cut?(r) }
  if cuts.zero?
    faults << "no frozen published cut is in scope. Those bytes are what an assistant author " \
              "actually reads and they can never be edited, so holding them is the whole point " \
              "of the rule reaching them"
  end

  Scope.new(files, skipped, exempted, faults)
end

# ── output ───────────────────────────────────────────────────────────────────

def print_scope(scope)
  puts "SCOPE — `git ls-files` in this repository, minus the exemptions and anything not text"
  puts "  in scope       : #{scope.files.size} file(s), " \
       "#{scope.files.keys.count { |r| frozen_cut?(r) }} of them frozen published cut(s)"
  SURFACES.each do |label, pred|
    puts "    #{label.ljust(32)}: #{scope.files.keys.count { |r| pred.call(r) }}"
  end
  puts "  not text       : #{scope.skipped.size} file(s) — decided from the bytes, not from an " \
       "extension#{scope.skipped.empty? ? '' : " (#{scope.skipped.join(', ')})"}"
  puts "  exempt         :"
  EXEMPTIONS.each do |x|
    puts "    #{x[:id]} #{x[:what].ljust(14)} #{scope.exempted[x[:id]].size} file(s) — #{x[:why]}"
  end
  puts "  and, inside R4, a name that is the TEXT OF A LINK: a page states its author the way a " \
       "package manifest does"
  puts "  and, inside every rule, a line carrying a live TODO/FIXME marker, which is required to " \
       "name the row that drains it"
end

def print_census(scope)
  puts
  puts "CENSUS over the exempt corpus — PRINTED, NEVER RED. It is worth reading and it is not " \
       "what holds anything:"
  corpus = EXEMPTIONS.flat_map { |x| scope.exempted[x[:id]] }
  texts  = corpus.filter_map { |rel| read_text(File.join(REPO, rel)) }
  zeros  = []
  RULES.each do |rule|
    n = texts.sum { |t| t.each_line.count { |l| violates?(rule, l) } }
    zeros << rule[:id] if n.zero?
    puts "  #{rule[:id]} #{rule[:what].ljust(48)} #{n} line(s) in #{corpus.size} exempt file(s)"
  end
  # DERIVED, NEVER TYPED. The sentence that stood here named a rule and asserted its count was
  # zero; the count was seven, one line above, on every run for as long as the claim was printed.
  # Whatever this table says, it says on THIS run.
  puts "  A ZERO ON THIS TABLE IS NOT A FAULT, and a COUNT on it is not coverage — which is the " \
       "reason the census is not the vacuity mechanism: a rule whose subject this corpus simply " \
       "does not contain reads exactly like a rule that has stopped matching anything at all. " \
       "#{zeros.empty? ? 'No rule is at zero on this run.' : "At zero on this run: #{zeros.join(', ')}."}"
end

# COUNTED, NEVER BANNED. Printed in full — path, line and the sentence — because
# a number a reader cannot attribute is not a number they can drain. The exit
# code never moves on any of it.
def print_counted(scope)
  puts
  puts "COUNTED, NEVER BANNED — over the same published files the rules run on. Each of these " \
       "constructions spells archaeology and live English with the same letters, so each is a " \
       "list a human adjudicates, never a gate. The frozen-cut column is what holds the pattern " \
       "itself: those bytes cannot be repaired, so a count over them that moves is a pattern " \
       "that moved:"
  cuts = scope.files.select { |rel, _| frozen_cut?(rel) }
  COUNTED.each do |c|
    hits    = scope.files.flat_map { |rel, text| scan_text(rel, text, [c]) }
    live    = hits.reject { |h| frozen_cut?(h.path) }
    in_cuts = cuts.sum { |rel, text| scan_text(rel, text, [c]).size }
    puts "  #{c[:id]} #{c[:what]} — #{hits.size} line(s), #{live.size} outside the frozen cuts " \
         "and #{in_cuts} in them (declared #{c[:in_cuts]}, re-measured on this run)"
    live.each { |h| puts "       #{h.path}:#{h.line} — #{h.text}" }
    puts "       #{c[:remedy]}." unless live.empty?
  end
  puts "  A ZERO HERE IS NOT A PASS AND A COUNT HERE IS NOT A FAILURE. The detector behind each " \
       "is re-proved on every run against fixtures that are not in this tree, which is the only " \
       "reason a zero on this table would be worth reading."
end

def run_check
  scope = build_scope
  print_scope(scope)
  puts

  failed = false

  faults = rule_detector_faults + text_reader_faults + scope.faults + counted_cut_faults(scope)
  unless faults.empty?
    failed = true
    puts "FAIL — the guard cannot answer its own question:"
    faults.each { |f| puts "  x #{f}" }
    puts
  end

  RULES.each do |rule|
    hits = scope.files.flat_map { |rel, text| scan_text(rel, text, [rule]) }
    if hits.empty?
      puts "#{rule[:id]}. #{rule[:none]} on any published surface — OK (#{scope.files.size} files, " \
           "detector re-proved on this run)"
      next
    end

    failed = true
    puts "#{rule[:id]}. #{rule[:what]} on a published surface — #{hits.size} occurrence(s):"
    hits.each do |h|
      cut = frozen_cut?(h.path) ? " [FROZEN CUT — the bytes cannot move, so the RULE is wrong]" : ""
      puts "  FAIL #{h.path}:#{h.line}#{cut} — #{rule[:what]} #{WHERE[h.where]} — " \
           "#{rule[:remedy]}: #{h.text}"
    end
  end

  print_counted(scope)
  print_census(scope)

  puts
  if failed
    puts "check-published-archaeology FAILED"
    1
  else
    puts "check-published-archaeology: OK — #{RULES.size} rules and #{COUNTED.size} counted " \
         "construction(s) over #{scope.files.size} published file(s); every one of them re-proved " \
         "its own detector against fixtures that are not in this tree"
    0
  end
end

def run_list
  scope = build_scope
  print_scope(scope)
  puts
  puts "FILES IN SCOPE"
  scope.files.keys.each { |rel| puts "  #{rel}" }
  puts
  print_counted(scope)
  print_census(scope)
  scope.faults.empty? ? 0 : 1
end

# ── self-test ────────────────────────────────────────────────────────────────

def self_test
  failures = []
  check = lambda do |name, ok|
    puts(ok ? "  ok   #{name}" : "  FAIL #{name}")
    failures << name unless ok
  end

  # ── one planted RED arm per rule, in each surface a citation can hide ──────
  [
    ["R1 in a narrative page",
     "specification.html", "  <p>The wire error contract (T-054) is closed.</p>\n", "R1", :page],
    ["R1 in the formal specification",
     "spec/protocol.md", "This clause was widened by K-1035.\n", "R1", :doc],
    ["R1 in a JSON Schema description",
     "spec/schemas/x.schema.json", "{ \"description\": \"the toll, K-512\" }\n", "R1", :data],
    ["R1 in a shell comment",
     "spec/schemas/validate.sh", "#!/usr/bin/env bash\n# the rejected corpus, T-192.\n", "R1", :comment],
    ["R1 in a line of shell that runs",
     "spec/schemas/validate.sh", "echo \"see K-1035\"\n", "R1", :code],
    ["R1 in the skill an assistant author reads",
     "skill.md", "The refusal is the one described in K-1035.\n", "R1", :doc],
    ["R2 in the formal specification",
     "spec/protocol.md", "The refusal shape is fixed by ADR-0018.\n", "R2", :doc],
    ["R2 in a narrative page",
     "specification.html", "  <p>Decided in ADR-0007.</p>\n", "R2", :page],
    ["R3 quoted Russian in a narrative page",
     "specification.html", "  <p>«пусть будет 1m».</p>\n", "R3", :page],
    ["R3 Cyrillic in the formal specification",
     "spec/protocol.md", "Убери из демок всю археологию.\n", "R3", :doc],
    ["R3 Cyrillic in a JSON Schema description",
     "spec/schemas/x.schema.json", "{ \"description\": \"это паблик\" }\n", "R3", :data],
    ["R4 the maintainer named in prose on a page",
     "index.html", "  <p>Phil accepted this control's weakness openly.</p>\n", "R4", :page],
    ["R4 the maintainer named in the formal specification",
     "spec/protocol.md", "Phil ruled that a bare offset is refused.\n", "R4", :doc],
    ["R5 a past state narrated on the normative page",
     "specification.html",
     "  <p>It used to be the other way round: the catalog was behind a Bearer token.</p>\n",
     "R5", :page],
    ["R5 a past state narrated in the formal specification",
     "spec/protocol.md",
     "This is a modelling rule, and it used to be the other way round.\n", "R5", :doc],
    ["R5 `formerly` in the formal specification",
     "spec/protocol.md", "The published field was formerly named `zone`.\n", "R5", :doc],
    ["R5 `previously` on a problem-code page",
     "problems/verb_not_found/index.html",
     "    <p>This code previously covered an unserved module as well.</p>\n", "R5", :page],
    ["R5 a past state narrated in a JSON Schema description",
     "spec/schemas/x.schema.json",
     "{ \"description\": \"the toll, historically a fixed cost\" }\n", "R5", :data],
    ["R5 a past state narrated in a shell comment",
     "spec/schemas/validate.sh",
     "#!/usr/bin/env bash\n# before the fix this enum carried 0.3's module names.\n",
     "R5", :comment],
    ["R5 `cutover` in the skill an assistant author reads",
     "skill.md", "The per-verb cutover moved this paragraph.\n", "R5", :doc],
  ].each do |name, rel, body, rule_id, expected_where|
    hits = scan_text(rel, body)
    mine = hits.select { |h| h.rule[:id] == rule_id }
    check.call("detects #{name}", !mine.empty?)
    next if mine.empty?

    check.call("…and places it #{expected_where}", mine.first.where == expected_where)
  end

  # ── the carve-outs, and each pattern's own boundaries ─────────────────────
  check.call("does NOT flag the site's BYLINE — a name that is the text of a link is a credit, " \
             "the way a package manifest states its author",
             scan_text("index.html",
                       %(    Built by <a href="https://example.invalid">Phil Pirozhkov</a>.\n)).empty?)
  check.call("…and DOES flag the same name in a sentence on the same page",
             !scan_text("index.html", "  <p>Phil ruled that a bare offset is refused.</p>\n").empty?)
  check.call("does NOT flag a live TODO carrying the row it names",
             scan_text("spec/protocol.md", "TODO(K-1099): widen the clause.\n").empty?)
  check.call("does NOT flag a live FIXME carrying the row it names",
             scan_text("spec/protocol.md", "FIXME: T-186 — narrow this.\n").empty?)
  check.call("does NOT flag OK-1234, RFC 8628 or CVE-2021-0001 (no word boundary before the K)",
             scan_text("spec/protocol.md",
                       "OK-1234 is a fixture id, RFC 8628 a standard, CVE-2021-0001 neither.\n").empty?)
  check.call("does NOT flag too-few-digit or too-many-digit lookalikes",
             scan_text("spec/protocol.md", "K-12, T-9, ADR-12 and ADR-99999 are not citations.\n").empty?)
  check.call("does NOT flag guillemets, en dashes, accented Latin, arrows or a currency name",
             scan_text("specification.html",
                       "  <p>«08:00-10:00 (Europe/Dublin)», naive, <- ->, EUR 200.</p>\n").empty?)
  check.call("does NOT flag a word that merely CONTAINS the maintainer's name",
             scan_text("spec/protocol.md",
                       "Philately and philosophy are not attributions.\n").empty?)

  # ── R5's boundaries: the two legitimate past-tense uses, verbatim ─────────
  #
  # These are the sentences the marker set was argued against, written out here
  # rather than read from the pages, so that a later widening of R5 reddens THIS
  # file instead of a published document. Each is upheld deliberately: a frozen
  # cut can still be fetched, and an operator's withdrawn verb can still be
  # dialed, so both describe something a reader can meet.
  r5 = ->(rel, body) { scan_text(rel, body).any? { |h| h.rule[:id] == "R5" } }

  check.call("R5 does NOT flag the PER-CUT HISTORY CLAUSE on the normative page — a cut is " \
             "frozen and published, so a past tense about one is the present tense of a " \
             "permanent artefact",
             !r5.call("specification.html",
                      "  <p>0.4.10 on this same wire but describing a descriptor slot that has " \
                      "since been withdrawn.</p>\n"))
  check.call("R5 does NOT flag the same clause in the cut table",
             !r5.call("skills.md",
                      "| `skill-v0.4.3.md` | 0.4 | 0.4.0-0.4.2 describe wires that have since " \
                      "changed. |\n"))
  check.call("R5 does NOT flag a LIVE OPERATOR CAVEAT — a verb an OPERATOR has withdrawn is what " \
             "the vocabulary page is FOR",
             !r5.call("problems/verb_not_found/index.html",
                      "    <p>a typo, or a verb that has since been withdrawn.</p>\n"))
  check.call("R5 does NOT flag a live caveat qualifying a recorded run",
             !r5.call("index.html",
                      "      <p>against the 0.3 wire these demos have since replaced.</p>\n"))
  check.call("R5 does NOT flag `previously-claimed` — a claim made earlier in THIS run, not our " \
             "past",
             !r5.call("spec/protocol.md",
                      "Release a previously-claimed id with a compensating action.\n"))
  check.call("R5 does NOT flag the tail of a HYPHENATED COMPOUND before `be`",
             !r5.call("spec/protocol.md",
                      "A key cross-used to be minted twice is refused.\n"))
  check.call("R5 does NOT flag the ordinary passive `used to` — that construction is COUNTED " \
             "(C2), never banned, because nothing lexical forks it from narration",
             !r5.call("spec/protocol.md", "The key used to sign mandates is the origin's.\n"))

  # ── the counted constructions, in both directions ────────────────────────
  counted = ->(id, rel, body) { scan_text(rel, body, COUNTED).any? { |h| h.rule[:id] == id } }

  check.call("C1 COUNTS a `has since` that is narration",
             counted.call("C1", "spec/descriptor-house-style.md",
                          "The spec has since caught up and passed this guide.\n"))
  check.call("…and counts the two legitimate uses too, because it is a list a human adjudicates " \
             "and not a gate — a census that pre-judged them would be the ban this file refused",
             counted.call("C1", "problems/verb_not_found/index.html",
                          "    <p>a verb that has since been withdrawn.</p>\n"))
  check.call("C1 does NOT fire on a bare `since` with no auxiliary before it",
             !counted.call("C1", "specification.html",
                           "  <p>Since the catalog is public, a verb name is not a secret.</p>\n"))
  check.call("C2 COUNTS a bare `used to` that narrates",
             counted.call("C2", "spec/protocol.md",
                          "The numeral that used to stand here said two.\n"))
  check.call("C2 COUNTS the ordinary passive as well — the two are spelled alike, which is the " \
             "whole reason this is a census",
             counted.call("C2", "spec/protocol.md",
                          "The key used to sign mandates is the origin's.\n"))
  check.call("C2 does NOT double-report the copula R5 already owns",
             !counted.call("C2", "spec/protocol.md", "It used to be the other way round.\n"))
  check.call("C2 does NOT fire on the tail of `refused to` — the word boundary is the pattern, " \
             "not a detail",
             !counted.call("C2", "spec/protocol.md",
                           "a grant row this endpoint just refused to issue\n"))
  check.call("C2 does NOT fire on the tail of a HYPHENATED COMPOUND — `cross-used to` is one " \
             "hyphenated verb and an infinitive",
             !counted.call("C2", "spec/protocol.md",
                           "being cross-used to mint anything else\n"))

  check.call("C3 COUNTS a `no longer` that dates a live rule against a retired wire",
             counted.call("C3", "spec/descriptor-house-style.md",
                          "  This is no longer hygiene: validation is unconditional.\n"))
  check.call("…and counts the LIVE readings too — a cache serving verbs an operator withdrew, " \
             "an unlinked key the operator cannot resolve — because the two are spelled alike " \
             "and a census that pre-judged them would be the ban this file refused",
             counted.call("C3", "specification.html",
                          "  <p>a CDN serving last week's verbs to an assistant that then calls " \
                          "verbs which no longer exist.</p>\n") &&
             counted.call("C3", "specification.html",
                          "  <p>the operator no longer knows the key; re-register is the " \
                          "remedy.</p>\n"))
  check.call("C3 does NOT fire on `no longer-lived` — a comparative is not a withdrawal, and " \
             "the hyphen guard is the pattern rather than a detail",
             !counted.call("C3", "spec/protocol.md",
                           "There is no longer-lived credential than the mandate itself.\n"))
  check.call("C3 does NOT fire across a comma — `no, longer windows are refused` is two clauses",
             !counted.call("C3", "spec/protocol.md", "No, longer windows are refused.\n"))

  check.call("C4 COUNTS a version that STAMPS a fact which is simply true",
             counted.call("C4", "onboarding.html",
                          "  <p>Since 0.4 the input schema is a protocol requirement.</p>\n"))
  check.call("…and counts a version that SCOPES a rule a reader IS bound by, because nothing " \
             "lexical forks the two and the adjudication is the human's",
             counted.call("C4", "specification.html",
                          "  <p>From 1.0 onward the wire stays backward-compatible.</p>\n"))
  check.call("C4 does NOT fire on a version that is simply NAMED — the construction is the " \
             "temporal preposition, not the number",
             !counted.call("C4", "specification.html",
                           "  <p>This page specifies protocol version 0.4.</p>\n"))
  check.call("C4 does NOT fire on a date or a price — a cursor issued on 2026-08-30, EUR 12.50",
             !counted.call("C4", "spec/protocol.md",
                           "A cursor issued on 2026-08-30 is opaque, and EUR 12.50 is a price.\n"))

  # ── the detector arms themselves ─────────────────────────────────────────
  rf = rule_detector_faults
  check.call("every PROBE is still flagged and every FOIL still is not, across every branch of " \
             "every pattern (#{RULES.size} rules + #{COUNTED.size} counted, " \
             "#{(RULES + COUNTED).sum { |r| Array(r[:probe]).size }} probes and " \
             "#{(RULES + COUNTED).sum { |r| Array(r[:foil]).size }} foils)" \
             "#{rf.empty? ? '' : " — #{rf.join('; ')}"}", rf.empty?)
  tf = text_reader_faults
  check.call("the non-text skip refuses a NUL blob and invalid bytes, and READS a valid Cyrillic " \
             "sentence#{tf.empty? ? '' : " — #{tf.join('; ')}"}", tf.empty?)

  # …and the arms must be able to FAIL. A detector arm that cannot go red is
  # the same green nothing it was built to catch, so each is driven off a
  # deliberately broken rule rather than trusted.
  broken_probe = { id: "RX", re: /this pattern matches nothing/, what: "a fixture", none: "-",
                   remedy: "-", probe: "a ledger id, K-480", foil: "nothing here" }
  check.call("a rule whose pattern stopped matching its own probe is REPORTED",
             !violates?(broken_probe, broken_probe[:probe]))
  broken_foil = { id: "RY", re: /\bK-\d+\b/, what: "a fixture", none: "-", remedy: "-",
                  probe: "K-480", foil: "K-12 has too few digits" }
  check.call("a rule widened until it swallows its own foil is REPORTED",
             violates?(broken_foil, broken_foil[:foil]))

  # …and the arm must walk EVERY branch of an alternation, not just the first.
  # This is the fixture for R5's shape: a rule with several probes, one of which
  # its pattern has stopped matching. An arm that checked only the first probe
  # would pass here, and a marker silently dropped from R5 would be exactly as
  # invisible as the narration it was supposed to ban.
  partial = { id: "RZ", re: /\bformerly\b/i, what: "a fixture", none: "-", remedy: "-",
              probe: ["The field was formerly named zone.",
                      "It used to be the other way round."],
              foil: ["Nothing in this sentence is a marker."] }
  pf = rule_detector_faults([partial])
  check.call("a rule that has stopped matching ONE branch of its own alternation is REPORTED, " \
             "and the report names that branch (#{pf.size} fault(s))",
             pf.size == 1 && pf.first.include?("It used to be the other way round."))

  # ── the scope arms, against the live repository ──────────────────────────
  scope = build_scope
  check.call("the scope is non-empty (#{scope.files.size} published file(s))", !scope.files.empty?)
  check.call("no exemption covers zero tracked files, and every published surface class is " \
             "reached#{scope.faults.empty? ? '' : " — #{scope.faults.join('; ')}"}",
             scope.faults.empty?)
  check.call("the frozen published cuts are IN scope " \
             "(#{scope.files.keys.count { |r| frozen_cut?(r) }} cut(s)) — those bytes are what an " \
             "assistant author reads",
             scope.files.keys.count { |r| frozen_cut?(r) }.positive?)
  check.call("…and they carry no violation of any rule here, R5 INCLUDED. A frozen cut cannot be " \
             "edited, so a rule that reddens on one is the wrong rule and must be dropped, never " \
             "the cut — this is the arm every new rule is checked against FIRST, and it is why " \
             "the sibling's retired-wire ban is not here at all",
             scope.files.select { |rel, _| frozen_cut?(rel) }
                  .flat_map { |rel, text| scan_text(rel, text) }.empty?)
  # …and every CENSUS is measured against those same frozen bytes, in whichever
  # direction it declares. C1 and C2 are declared ABSENT there — a cut describes
  # a wire in the present tense of its own day and does not narrate the day
  # before — and C3 and C4 are declared PRESENT, which is what makes them
  # checkable at all: a census has no exit code of its own, so the only thing
  # that can tell a drained backlog from a broken pattern is a corpus nobody is
  # allowed to repair.
  ccf = counted_cut_faults(scope)
  cut_census = COUNTED.map do |c|
    n = scope.files.select { |rel, _| frozen_cut?(rel) }
             .sum { |rel, text| scan_text(rel, text, [c]).size }
    "#{c[:id]}=#{n}/#{c[:in_cuts]}"
  end.join(" ")
  check.call("…and every counted construction's frozen-cut expectation still holds, re-measured " \
             "on this run rather than trusted (#{cut_census})" \
             "#{ccf.empty? ? '' : " — #{ccf.join('; ')}"}", ccf.empty?)

  # …and THAT arm must be able to go red in both of its directions, so each is
  # driven off a deliberately wrong declaration rather than trusted.
  flipped = COUNTED.map { |c| c.merge(in_cuts: c[:in_cuts] == :none ? :some : :none) }
  check.call("a census declared PRESENT in the frozen cuts whose pattern has stopped matching " \
             "them is REPORTED, and so is one declared ABSENT that starts matching " \
             "(#{counted_cut_faults(scope, flipped).size} fault(s) when every declaration is " \
             "inverted)",
             counted_cut_faults(scope, flipped).size == COUNTED.size)
  check.call("a census that declares no frozen-cut expectation at all is REPORTED, so the arm " \
             "cannot be switched off by omission",
             counted_cut_faults(scope, [COUNTED.first.reject { |k, _| k == :in_cuts }]).size == 1)
  check.call("the non-text skip dropped at least one tracked file (#{scope.skipped.size}) — the " \
             "icons this site serves are why the file set is decided from the bytes",
             !scope.skipped.empty?)
  check.call("nothing exempt is also in scope",
             scope.files.keys.none? { |rel| exempt_for(rel) })
  spec_tracked = (scope.files.keys + scope.skipped + scope.exempted.values.flatten)
                 .select { |rel| rel.start_with?("spec/") }
  spec_tooling = spec_tracked.reject { |rel| rel.end_with?(".json", ".md") }
  check.call("no exemption reaches under `spec/` — what ships beside the formal specification is " \
             "in scope whatever kind of file it is, TOOLING INCLUDED (#{spec_tracked.size} " \
             "tracked, #{spec_tooling.size} of them neither schema nor prose: " \
             "#{spec_tooling.sort.join(', ')})",
             spec_tracked.none? { |rel| exempt_for(rel) })
  check.call("…and that boundary still has a subject: at least one tracked file under `spec/` is " \
             "neither schema nor prose, so the arm above is a statement about something",
             !spec_tooling.empty?)
  check.call("this guard's own source is exempt — its fixtures are violations by construction, " \
             "and a gate with a hole in the shape of its own subject is not a gate",
             !exempt_for("bin/check-published-archaeology").nil?)

  if failures.empty?
    puts "SELF-TEST OK"
    0
  else
    puts "SELF-TEST FAILED: #{failures.size} arm(s)"
    1
  end
end

exit(
  if ARGV.include?("--self-test") then self_test
  elsif ARGV.include?("--list")   then run_list
  else run_check
  end
)
